<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Priority heatmap: priority score × risk type -->
    <record id="view_priority_heatmap_pivot" model="ir.ui.view">
        <field name="name">maintenance.request.priority.pivot</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <pivot string="Priority Heatmap">
                <field name="x_risk_type" type="row"/>
                <field name="x_priority_score" type="col"/>
                <field name="x_estimated_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_priority_heatmap_graph" model="ir.ui.view">
        <field name="name">maintenance.request.priority.graph</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <graph string="Priority Heatmap" type="bar">
                <field name="x_priority_score"/>
                <field name="x_estimated_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_priority_heatmap" model="ir.actions.act_window">
        <field name="name">Priority Heatmap</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('x_request_type', '=', 'deferred'), ('stage_id.done', '=', False)]</field>
    </record>
</odoo>
