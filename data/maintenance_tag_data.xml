<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tags for categorizing maintenance requests.
             Uses maintenance.equipment.category as the "tag" surrogate when
             appropriate; the tags below live on maintenance.team.category_ids
             in core Odoo so we use maintenance.equipment.category records. -->
        <record id="maintenance_tag_deferred" model="maintenance.equipment.category">
            <field name="name">Deferred Maintenance</field>
            <field name="color">2</field>
        </record>
        <record id="maintenance_tag_safety" model="maintenance.equipment.category">
            <field name="name">Safety</field>
            <field name="color">1</field>
        </record>
        <record id="maintenance_tag_revenue" model="maintenance.equipment.category">
            <field name="name">Revenue Impact</field>
            <field name="color">3</field>
        </record>
        <record id="maintenance_tag_compliance" model="maintenance.equipment.category">
            <field name="name">Compliance</field>
            <field name="color">4</field>
        </record>
        <record id="maintenance_tag_cosmetic" model="maintenance.equipment.category">
            <field name="name">Cosmetic</field>
            <field name="color">5</field>
        </record>
    </data>
</odoo>
