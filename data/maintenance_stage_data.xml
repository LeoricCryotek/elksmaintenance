<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Helpdesk-style ticket stages -->
        <record id="stage_new" model="maintenance.stage">
            <field name="name">New</field>
            <field name="sequence">1</field>
            <field name="done">False</field>
            <field name="fold">False</field>
        </record>

        <record id="stage_in_progress" model="maintenance.stage">
            <field name="name">In Progress</field>
            <field name="sequence">2</field>
            <field name="done">False</field>
            <field name="fold">False</field>
        </record>

        <record id="stage_waiting" model="maintenance.stage">
            <field name="name">Waiting on Parts / Vendor</field>
            <field name="sequence">3</field>
            <field name="done">False</field>
            <field name="fold">False</field>
        </record>

        <record id="stage_resolved" model="maintenance.stage">
            <field name="name">Resolved</field>
            <field name="sequence">4</field>
            <field name="done">True</field>
            <field name="fold">True</field>
        </record>

        <record id="stage_cancelled" model="maintenance.stage">
            <field name="name">Cancelled</field>
            <field name="sequence">5</field>
            <field name="done">True</field>
            <field name="fold">True</field>
        </record>

    </data>
</odoo>
