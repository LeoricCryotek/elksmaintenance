<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ===== Custom Maintenance Stages ===== -->
        <record id="stage_identified" model="maintenance.stage">
            <field name="name">Identified</field>
            <field name="sequence">1</field>
            <field name="done">False</field>
            <field name="fold">False</field>
        </record>

        <record id="stage_evaluating" model="maintenance.stage">
            <field name="name">Evaluating</field>
            <field name="sequence">2</field>
            <field name="done">False</field>
            <field name="fold">False</field>
        </record>

        <record id="stage_deferred" model="maintenance.stage">
            <field name="name">Deferred (Backlog)</field>
            <field name="sequence">3</field>
            <field name="done">False</field>
            <field name="fold">False</field>
        </record>

        <record id="stage_approved" model="maintenance.stage">
            <field name="name">Approved (Budgeted)</field>
            <field name="sequence">4</field>
            <field name="done">False</field>
            <field name="fold">False</field>
        </record>

        <record id="stage_in_progress" model="maintenance.stage">
            <field name="name">In Progress</field>
            <field name="sequence">5</field>
            <field name="done">False</field>
            <field name="fold">False</field>
        </record>

        <record id="stage_completed" model="maintenance.stage">
            <field name="name">Completed</field>
            <field name="sequence">6</field>
            <field name="done">True</field>
            <field name="fold">True</field>
        </record>

        <record id="stage_cancelled" model="maintenance.stage">
            <field name="name">Cancelled</field>
            <field name="sequence">7</field>
            <field name="done">True</field>
            <field name="fold">True</field>
        </record>
    </data>
</odoo>
