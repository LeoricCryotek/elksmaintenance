<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Most automation logic lives on the Python model (write/
            _handle_stage_transition / _create_budget_entry).
            This file is reserved for any scheduled actions we need.
        -->

        <!-- Monthly Trustee reminder:
             Flag any deferred items that have been sitting with no
             target year set, or whose target year has passed. -->
        <record id="cron_review_stale_deferred" model="ir.cron">
            <field name="name">Elks Maintenance: Review stale deferred items</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_flag_stale_deferred()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
