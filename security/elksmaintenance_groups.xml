<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="res_groups_privilege_elksmaint" model="res.groups.privilege">
            <field name="name">Elks Maintenance</field>
            <field name="category_id" ref="base.module_category_operations"/>
            <field name="sequence">70</field>
        </record>

        <record id="group_elksmaint_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_elksmaint"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_elksmaint_trustee" model="res.groups">
            <field name="name">Trustee</field>
            <field name="privilege_id" ref="res_groups_privilege_elksmaint"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('group_elksmaint_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_elksmaint_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_elksmaint"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_elksmaint_trustee'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
