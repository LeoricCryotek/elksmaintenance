<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Form view inheritance ===== -->
    <record id="view_maintenance_request_form_elks" model="ir.ui.view">
        <field name="name">maintenance.request.form.elks</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <!-- Add button for recalculating priority -->
            <xpath expr="//header" position="inside">
                <button name="action_recalculate_priority"
                        type="object"
                        string="Recalculate Priority"
                        class="btn-secondary"/>
                <button name="action_view_budget_entry"
                        type="object"
                        string="View Budget Entry"
                        class="btn-link"
                        invisible="not x_analytic_entry_id"/>
            </xpath>

            <!-- Insert our fields near the top of the sheet -->
            <xpath expr="//sheet/group" position="after">
                <group string="Elks Classification">
                    <group>
                        <field name="x_request_type"/>
                        <field name="x_risk_type"/>
                        <field name="x_funding_source"/>
                        <field name="x_target_year"/>
                    </group>
                    <group>
                        <field name="x_priority_score"/>
                        <field name="x_estimated_cost"/>
                        <field name="x_actual_cost"/>
                        <field name="x_cost_variance" readonly="True"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <group string="Accounting &amp; Asset" invisible="x_request_type != 'deferred'">
                    <group>
                        <field name="x_elks_account_id"/>
                        <field name="x_elks_department_id" readonly="True"/>
                    </group>
                    <group>
                        <field name="x_analytic_entry_id" readonly="True"/>
                        <field name="x_equipment_path" readonly="True"/>
                        <field name="x_equipment_sq_ft" readonly="True"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ===== List view inheritance ===== -->
    <record id="view_maintenance_request_tree_elks" model="ir.ui.view">
        <field name="name">maintenance.request.tree.elks</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="x_request_type" optional="show"/>
                <field name="x_priority_score" optional="show"/>
                <field name="x_estimated_cost" optional="show" sum="Total"/>
                <field name="x_actual_cost" optional="hide" sum="Actual"/>
                <field name="x_target_year" optional="show"/>
                <field name="x_risk_type" optional="show"/>
                <field name="x_funding_source" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ===== Kanban view inheritance ===== -->
    <record id="view_maintenance_request_kanban_elks" model="ir.ui.view">
        <field name="name">maintenance.request.kanban.elks</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='priority']" position="after">
                <field name="x_request_type"/>
                <field name="x_priority_score"/>
                <field name="x_estimated_cost"/>
                <field name="x_target_year"/>
                <field name="x_risk_type"/>
            </xpath>
        </field>
    </record>

    <!-- ===== Search view inheritance ===== -->
    <record id="view_maintenance_request_search_elks" model="ir.ui.view">
        <field name="name">maintenance.request.search.elks</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_deferred" string="Deferred Backlog"
                        domain="[('x_request_type', '=', 'deferred'),
                                 ('stage_id.done', '=', False)]"/>
                <filter name="filter_high_priority" string="High Priority (≥12)"
                        domain="[('x_priority_score', '&gt;=', 12)]"/>
                <filter name="filter_safety" string="Safety / Compliance"
                        domain="[('x_risk_type', 'in', ['safety', 'compliance'])]"/>
                <filter name="filter_has_target" string="Has Target Year"
                        domain="[('x_target_year', '!=', False)]"/>
                <filter name="filter_no_target" string="No Target Year"
                        domain="[('x_target_year', '=', False)]"/>
                <separator/>
                <group>
                    <filter name="group_type" string="Request Type"
                            context="{'group_by': 'x_request_type'}"/>
                    <filter name="group_target_year" string="Target Year"
                            context="{'group_by': 'x_target_year'}"/>
                    <filter name="group_risk" string="Risk"
                            context="{'group_by': 'x_risk_type'}"/>
                    <filter name="group_funding" string="Funding Source"
                            context="{'group_by': 'x_funding_source'}"/>
                    <filter name="group_gl_account" string="GL Account"
                            context="{'group_by': 'x_elks_account_id'}"/>
                    <filter name="group_priority" string="Priority Score"
                            context="{'group_by': 'x_priority_score'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ===== Deferred Backlog dedicated action ===== -->
    <record id="action_deferred_backlog" model="ir.actions.act_window">
        <field name="name">Deferred Maintenance Backlog</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">list,kanban,pivot,graph,form</field>
        <field name="domain">[('x_request_type', '=', 'deferred'), ('stage_id.done', '=', False)]</field>
        <field name="context">{
            'search_default_group_target_year': 1,
            'search_default_group_risk': 1,
        }</field>
    </record>

    <!-- All work requests -->
    <record id="action_all_requests" model="ir.actions.act_window">
        <field name="name">Work Requests</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">kanban,list,pivot,graph,calendar,form</field>
    </record>

    <!-- All assets -->
    <record id="action_all_equipment" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- Stages config -->
    <record id="action_maintenance_stages" model="ir.actions.act_window">
        <field name="name">Maintenance Stages</field>
        <field name="res_model">maintenance.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Teams config -->
    <record id="action_maintenance_teams" model="ir.actions.act_window">
        <field name="name">Maintenance Teams</field>
        <field name="res_model">maintenance.team</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
