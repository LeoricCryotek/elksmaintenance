<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trustee Dashboard: kanban-style form on elks.lodge.settings
         showing big-number tiles.  Opens the single settings record. -->
    <record id="view_elks_lodge_settings_dashboard" model="ir.ui.view">
        <field name="name">elks.lodge.settings.maintenance.dashboard</field>
        <field name="model">elks.lodge.settings</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <form string="Trustee Dashboard" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>Trustee Dashboard — Lodge Maintenance</h1>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="card border-danger">
                                <div class="card-body text-center">
                                    <h6 class="text-muted">Deferred Backlog</h6>
                                    <h2 class="text-danger">
                                        <field name="x_deferred_backlog_total"
                                               widget="monetary"/>
                                    </h2>
                                    <small class="text-muted">Total outstanding</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-primary">
                                <div class="card-body text-center">
                                    <h6 class="text-muted">Maintenance YTD</h6>
                                    <h2 class="text-primary">
                                        <field name="x_maintenance_cost_ytd"
                                               widget="monetary"/>
                                    </h2>
                                    <small class="text-muted">Actual spend (completed)</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-info">
                                <div class="card-body text-center">
                                    <h6 class="text-muted">Cost / Sq Ft</h6>
                                    <h2 class="text-info">
                                        $<field name="x_maintenance_cost_per_sqft_ytd"/>
                                    </h2>
                                    <small class="text-muted">
                                        <field name="x_total_sq_ft"/> sq ft
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-warning">
                                <div class="card-body text-center">
                                    <h6 class="text-muted">Building Sq Ft</h6>
                                    <h2 class="text-warning">
                                        <field name="x_total_sq_ft"/>
                                    </h2>
                                    <small class="text-muted">Lodge total</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4">
                        <field name="currency_id" invisible="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_trustee_dashboard_server" model="ir.actions.server">
        <field name="name">Trustee Dashboard</field>
        <field name="model_id" ref="elksfrs.model_elks_lodge_settings"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_trustee_dashboard()</field>
    </record>

    <record id="action_trustee_deferred_list" model="ir.actions.act_window">
        <field name="name">Deferred Backlog Detail</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">list,kanban,pivot,graph,form</field>
        <field name="domain">[('x_request_type', '=', 'deferred')]</field>
        <field name="context">{
            'search_default_filter_deferred': 1,
            'search_default_group_target_year': 1,
        }</field>
    </record>
</odoo>
