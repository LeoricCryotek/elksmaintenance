<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root app menu -->
    <menuitem id="menu_elks_maint_root"
              name="Elks Maintenance"
              sequence="60"
              web_icon="elksmaintenance,static/description/icon.png"
              groups="elksmaintenance.group_elksmaint_user"/>

    <!-- Tickets -->
    <menuitem id="menu_tickets"
              name="Tickets"
              parent="menu_elks_maint_root"
              sequence="10"/>

    <menuitem id="menu_all_tickets"
              name="All Tickets"
              parent="menu_tickets"
              action="action_all_tickets"
              sequence="10"/>

    <menuitem id="menu_open_tickets"
              name="Open Tickets"
              parent="menu_tickets"
              action="action_open_tickets"
              sequence="20"/>

    <!-- Reports -->
    <menuitem id="menu_reports"
              name="Reports"
              parent="menu_elks_maint_root"
              sequence="20"
              groups="elksmaintenance.group_elksmaint_trustee"/>

    <menuitem id="menu_meeting_report"
              name="Meeting Report"
              parent="menu_reports"
              action="action_meeting_report_wizard"
              sequence="10"/>

    <!-- Configuration -->
    <menuitem id="menu_config"
              name="Configuration"
              parent="menu_elks_maint_root"
              sequence="90"
              groups="elksmaintenance.group_elksmaint_manager"/>

    <menuitem id="menu_locations"
              name="Locations"
              parent="menu_config"
              action="action_maintenance_locations"
              sequence="10"/>

    <menuitem id="menu_stages"
              name="Stages"
              parent="menu_config"
              action="maintenance.hr_equipment_stage_action"
              sequence="20"/>

    <menuitem id="menu_teams"
              name="Teams"
              parent="menu_config"
              action="maintenance.maintenance_team_action_settings"
              sequence="30"/>
</odoo>
