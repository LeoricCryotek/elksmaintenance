<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend the equipment form to add Elks-specific fields -->
    <record id="view_maintenance_equipment_form_elks" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.elks</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Elks Asset Details">
                    <group>
                        <field name="parent_equipment_id"/>
                        <field name="full_path" readonly="True"/>
                        <field name="x_asset_class"/>
                        <field name="x_condition"/>
                    </group>
                    <group>
                        <field name="x_sq_ft"/>
                        <field name="x_install_date"/>
                        <field name="x_expected_life_years"/>
                        <field name="x_last_inspection_date"/>
                        <field name="x_replacement_cost"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <group string="Deferred Maintenance Summary">
                    <field name="x_deferred_request_count"/>
                    <field name="x_deferred_backlog_amount"/>
                    <button name="action_view_deferred_requests"
                            type="object" string="View Deferred Work"
                            class="btn-link"
                            invisible="x_deferred_request_count == 0"/>
                </group>
                <field name="child_equipment_ids" readonly="1">
                    <list>
                        <field name="name"/>
                        <field name="x_asset_class"/>
                        <field name="x_condition"/>
                        <field name="x_sq_ft"/>
                        <field name="x_deferred_backlog_amount"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <!-- Extend list view -->
    <record id="view_maintenance_equipment_tree_elks" model="ir.ui.view">
        <field name="name">maintenance.equipment.tree.elks</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="x_asset_class"/>
                <field name="x_condition" optional="show"/>
                <field name="x_sq_ft" optional="show"/>
                <field name="x_deferred_backlog_amount" optional="show"
                       sum="Total Backlog"/>
            </xpath>
        </field>
    </record>

    <!-- Search view extension -->
    <record id="view_maintenance_equipment_search_elks" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.elks</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="filter_buildings" string="Buildings"
                        domain="[('x_asset_class', '=', 'building')]"/>
                <filter name="filter_systems" string="Systems"
                        domain="[('x_asset_class', '=', 'system')]"/>
                <filter name="filter_poor_condition" string="Poor / Failing"
                        domain="[('x_condition', 'in', ['4', '5'])]"/>
                <group>
                    <filter name="group_asset_class" string="Asset Class"
                            context="{'group_by': 'x_asset_class'}"/>
                    <filter name="group_condition" string="Condition"
                            context="{'group_by': 'x_condition'}"/>
                    <filter name="group_parent" string="Parent Asset"
                            context="{'group_by': 'parent_equipment_id'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
