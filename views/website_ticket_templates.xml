<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Public Ticket Submission Form ===== -->
    <template id="website_ticket_form" name="Submit Maintenance Ticket">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-8">

                        <h2 class="mb-4">
                            <i class="fa fa-wrench me-2" title="Maintenance"/>
                            Report a Maintenance Issue
                        </h2>
                        <p class="text-muted mb-4">
                            Use this form to let the Maintenance Trustees know
                            about something that needs attention at the lodge.
                            You may attach any number of photos.
                        </p>

                        <form action="/maintenance/submit" method="post"
                              enctype="multipart/form-data"
                              class="card shadow-sm">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>

                            <div class="card-body">

                                <!-- Submitter info -->
                                <h5 class="fw-bold mb-3">Your Information</h5>
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label">
                                            Your Name <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" name="submitter_name"
                                               class="form-control" required="required"
                                               placeholder="John Smith"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Email</label>
                                        <input type="email" name="submitter_email"
                                               class="form-control"
                                               placeholder="john@example.com"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Phone</label>
                                        <input type="tel" name="submitter_phone"
                                               class="form-control"
                                               placeholder="(208) 555-1234"/>
                                    </div>
                                </div>

                                <hr/>

                                <!-- Issue details -->
                                <h5 class="fw-bold mb-3">Issue Details</h5>

                                <div class="mb-3">
                                    <label class="form-label">
                                        Title <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" name="name"
                                           class="form-control" required="required"
                                           placeholder="Brief description of the issue"/>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Issue Type</label>
                                        <select name="ticket_type" class="form-select">
                                            <option value="repair">Repair Needed</option>
                                            <option value="safety">Safety Hazard</option>
                                            <option value="cleaning">Cleaning / Janitorial</option>
                                            <option value="electrical">Electrical</option>
                                            <option value="plumbing">Plumbing</option>
                                            <option value="hvac">HVAC / Climate</option>
                                            <option value="exterior">Exterior / Grounds</option>
                                            <option value="other">Other</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Location</label>
                                        <select name="location_id" class="form-select">
                                            <option value="">-- Select a location --</option>
                                            <t t-foreach="locations" t-as="loc">
                                                <option t-att-value="loc.id"
                                                        t-esc="loc.name"/>
                                            </t>
                                        </select>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Location Detail</label>
                                    <input type="text" name="location_detail"
                                           class="form-control"
                                           placeholder="e.g. south wall near exit sign"/>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        Description <span class="text-danger">*</span>
                                    </label>
                                    <textarea name="description" rows="4"
                                              class="form-control" required="required"
                                              placeholder="Please describe the issue in detail..."/>
                                </div>

                                <hr/>

                                <!-- Photos — unlimited count via multi-file input -->
                                <h5 class="fw-bold mb-3">
                                    <i class="fa fa-camera me-1" title="Photos"/>
                                    Photos (optional)
                                </h5>
                                <p class="text-muted small mb-3">
                                    Select one or many photos showing the
                                    issue. Hold <kbd>Ctrl</kbd>
                                    (or <kbd>Cmd</kbd> on Mac) to pick
                                    several at once.
                                </p>
                                <div class="row">
                                    <div class="col-12 mb-3">
                                        <input type="file"
                                               name="photos"
                                               class="form-control"
                                               accept="image/*"
                                               multiple="multiple"/>
                                    </div>
                                </div>

                            </div>

                            <div class="card-footer text-end">
                                <button type="submit"
                                        class="btn btn-primary btn-lg">
                                    <i class="fa fa-paper-plane me-2" title="Submit"/>
                                    Submit Ticket
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ===== Thank You Page ===== -->
    <template id="website_ticket_thanks" name="Ticket Submitted">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-6 text-center">
                        <i class="fa fa-check-circle text-success"
                           style="font-size: 5rem;" title="Done"/>
                        <h2 class="mt-3">Thank You!</h2>
                        <p class="lead mt-3">
                            Your maintenance ticket has been submitted
                            and the Trustees have been notified.
                        </p>
                        <!-- Ticket details card is only rendered when
                             the controller passes a ticket record (custom
                             route).  The generic /maintenance/thanks
                             redirect used by the website Form builder
                             passes ticket=None and shows just the
                             thank-you message. -->
                        <div class="card mt-4" t-if="ticket">
                            <div class="card-body text-start">
                                <p class="mb-1">
                                    <strong>Ticket:</strong>
                                    <t t-esc="ticket.name"/>
                                </p>
                                <p class="mb-1" t-if="ticket.x_location_id">
                                    <strong>Location:</strong>
                                    <t t-esc="ticket.x_location_id.name"/>
                                </p>
                                <p class="mb-0" t-if="ticket.x_submitter_name">
                                    <strong>Submitted by:</strong>
                                    <t t-esc="ticket.x_submitter_name"/>
                                </p>
                            </div>
                        </div>
                        <a href="/maintenance" class="btn btn-outline-primary mt-4">
                            <i class="fa fa-plus me-1" title="Add"/>
                            Submit Another Ticket
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
